{
  "name": "Dograh password reset: send mail",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dograh-password-reset",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Checks the add-on's signature over the raw request body, then passes the mail on.\n// Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto and DOGRAH_RESET_WEBHOOK_SECRET (the same value as the add-on's secret file).\nconst crypto = require('crypto');\n\nconst item = $input.first();\n// The Webhook node's Raw Body option puts the unparsed body in the binary property 'data'.\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst received = (item.json.headers || {})['x-dograh-reset-signature'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.DOGRAH_RESET_WEBHOOK_SECRET).update(raw).digest('hex');\n\nconst a = Buffer.from(expected);\nconst b = Buffer.from(received);\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\nif (!valid) {\n  return [{ json: { valid: false } }];\n}\n\nconst body = JSON.parse(raw.toString('utf8'));\nreturn [{ json: { valid: true, to: body.to, subject: body.subject, text: body.text, html: body.html, kind: body.kind } }];\n"
      },
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "fromEmail": "reset-sender@example.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [660, -100],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "SMTP account (replace)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 204
        }
      },
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Respond 204",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, -100]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 401
        }
      },
      "id": "00000000-0000-4000-8000-000000000007",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 120]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Verify signature", "type": "main", "index": 0 }]]
    },
    "Verify signature": {
      "main": [[{ "node": "Signature valid?", "type": "main", "index": 0 }]]
    },
    "Signature valid?": {
      "main": [
        [{ "node": "Send Email", "type": "main", "index": 0 }],
        [{ "node": "Respond 401", "type": "main", "index": 0 }]
      ]
    },
    "Send Email": {
      "main": [[{ "node": "Respond 204", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  }
}
