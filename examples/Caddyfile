# Example Caddy site without Cloudflare (INSTALL.md, step 4). Caddy gets the TLS certificate itself.
# Replace dograh.example.com. Caddy forwards X-Forwarded-For and X-Forwarded-Proto to the front.
dograh.example.com {
	log {
		output file /var/log/caddy/dograh-access.log
		format filter {
			wrap json
			fields {
				# Reset links carry a single-use token in ?token=. Keep it out of the log.
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}

	reverse_proxy 127.0.0.1:8088
}
